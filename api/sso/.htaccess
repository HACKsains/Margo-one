# ==============================================================================
# MARGO ONE — ILMUNA SSO · ISOLATED SERVER-TO-SERVER API DIRECTORY (api/sso/)
# ==============================================================================
# Menonaktifkan auto_prepend_file Guardian Dome (HTML JS-interstitial browser)
# KHUSUS di folder machine-to-machine ini. Setiap endpoint dilindungi penuh oleh
# Public Key + Private Key (HMAC-SHA256 / RSA-2048 / DUAL), Timestamp +/-300s,
# Single-Use Nonce, PKCE S256, Domain/IP Allowlist, & Rate Limiter.
# ==============================================================================

<IfModule lsapi_module>
    php_value auto_prepend_file none
</IfModule>

<IfModule php7_module>
    php_value auto_prepend_file none
</IfModule>

<IfModule php_module>
    php_value auto_prepend_file none
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
